  "update_servers": [
    {
      "owner": "joomengine",
      "repo": "pkg-component-builder",
      "branch": "main",
      "path": "component_updates.xml"
    },
    {
      "owner": "joomengine",
      "repo": "another-repo",
      "path": "admin/component_updates.xml"
    }
  ]
}
======================================================
              ${PROGRAM_NAME} v${PROGRAM_VERSION}
              ${PROGRAM_URL}
======================================================
EOF
}

# RUN MAIN ┬┴┬┴┤(･_├┬┴┬┴
main "$@"
